<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SQL Query Generator</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/atom-one-dark.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <div class="main-wrapper">
        <!-- HEADER -->
        <header class="navbar-header">
            <nav class="navbar bg-white shadow-sm">
                <div class="container-fluid">
                    <a class="navbar-brand d-flex align-items-center gap-2">
                        <img src="/database_search.svg" width="40" height="34">
                        <div>
                            <h4 class="mb-0 fw-bold">SQL Query Generator</h4>
                            <small class="text-muted">AI-powered SQL from natural language</small>
                        </div>
                    </a>

                    <label class="theme-toggle">
                        <input type="checkbox" id="themeSwitcher">
                        <span class="slider">
                            <span class="icon sun">☀️</span>
                            <span class="icon moon">🌙</span>
                        </span>
                    </label>
                </div>
            </nav>
        </header>

        <!-- MAIN CONTENT -->
        <div class="main-content">
            <!-- SIDEBAR (HISTORY) -->
            <aside class="history-sidebar">
                <div class="sidebar-header">
                    <h6>📜 Query History</h6>
                    <button id="clearHistoryBtn" class="clear-history-btn" title="Clear all">🗑️</button>
                </div>
                <div id="historyList" class="history-list">
                    <p class="empty-message">No queries yet</p>
                </div>
            </aside>

            <!-- MAIN AREA -->
            <div class="container-fluid">
                <div class="row g-4 py-4">
                    <!-- LEFT: SCHEMA INPUT -->
                    <div class="col-lg-6">
                        <div class="input-card">
                            <div class="card-header">
                                <h5>📊 Database Schema</h5>
                                <small>Paste your CREATE TABLE statements</small>
                            </div>
                            <textarea id="schema-input" class="form-control schema-box"
                                placeholder="e.g. CREATE TABLE users (id INT PRIMARY KEY, name VARCHAR(100));"></textarea>
                        </div>
                    </div>

                    <!-- RIGHT: QUESTION & OUTPUT -->
                    <div class="col-lg-6">
                        <!-- QUESTION INPUT -->
                        <div class="input-card">
                            <div class="card-header">
                                <h5>💬 Your Question</h5>
                                <small>What do you want to query?</small>
                            </div>
                            <input type="text" id="question-input" class="form-control question-input"
                                placeholder="e.g., Get all users who signed up this month">
                        </div>

                        <!-- GENERATE BUTTON -->
                        <button id="generateBtn" class="btn btn-primary w-100 py-3 mb-4 generate-btn">
                            <span class="btn-icon">✨</span> Generate SQL Query
                        </button>

                        <!-- OUTPUT CARD -->
                        <div class="output-card">
                            <div class="card-header">
                                <h5>📝 Generated Query</h5>
                                <button id="copy-btn" class="copy-btn" title="Copy to clipboard">📋 Copy</button>
                            </div>
                            <div id="generatedQueryBox" class="generated-query-box">
                                <p class="placeholder-text">Your generated SQL query will appear here</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- QUICK EXAMPLES -->
                <div class="examples-section">
                    <h5 class="mb-3">🚀 Quick Examples</h5>
                    <div class="examples-grid">
                        <div class="example-card"
                            data-schema="CREATE TABLE orders (order_id INT, user_id INT, amount INT, status TEXT);"
                            data-question="Get all completed orders with amount > 5000">
                            <div class="example-icon">🛍️</div>
                            <div class="example-title">E-commerce Orders</div>
                        </div>

                        <div class="example-card"
                            data-schema="CREATE TABLE analytics (user_id INT, session_time INT, clicks INT);"
                            data-question="Show users who clicked more than 50 times">
                            <div class="example-icon">📊</div>
                            <div class="example-title">User Analytics</div>
                        </div>

                        <div class="example-card"
                            data-schema="CREATE TABLE students (id INT, name TEXT, grade INT, section TEXT);"
                            data-question="Fetch students with grade above 85">
                            <div class="example-icon">🎓</div>
                            <div class="example-title">Student Performance</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- LOADING SPINNER (Hidden by default) -->
    <div id="loadingSpinner" class="loading-spinner">
        <div class="spinner"></div>
        <p>Generating your SQL query...</p>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
    <script src="/js/script.js"></script>

</body>
</html>
